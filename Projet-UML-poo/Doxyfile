# Doxyfile minimal pour le projet UML vers C++ (Conducteur / Moto / Moteur)
# Génère la doc avec : doxygen Doxyfile
# La sortie HTML est dans docs/html/index.html

PROJECT_NAME           = "Conducteur - Moto - Moteur"
PROJECT_BRIEF          = "TP UML vers C++ - BTS CIEL2 IR"
OUTPUT_DIRECTORY       = docs
INPUT                  = include src
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES

UML_LOOK               = YES
HAVE_DOT               = NO
